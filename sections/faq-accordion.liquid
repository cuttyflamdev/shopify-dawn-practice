{{ 'section-faq-accordion.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-faq-accordion.js' | asset_url }}" defer></script>
<section class="faq">
    <div class="faq__header">
        {% if section.settings.heading != blank %}
        <h2 class="faq__heading">{{ section.settings.heading }}</h2>
        {% endif %}
    </div>

    <div class="faq__list">
        {%- for block in section.blocks -%}
            <div class="faq__item" {{ block.shopify_attributes }}>
                <button 
                    class="faq__question"
                    type="button"
                    aria-expanded="false"
                    aria-controls="faq-answer-{{ block.id }}"
                >
                    {{ block.settings.question }}
                </button>
                <div class="faq__answer" id="faq-answer-{{ block.id }}">
                    {{ block.settings.answer }}
                </div>
            </div>
        {%- endfor -%}
    </div>
</section>

{% schema %}
{
    "name": "FAQ Accordion",
    "settings": [
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Frequently Asked Questions"
        }        
    ],
    "blocks": [
        {
            "type": "faq_item",
            "name": "FAQ Item",
            "settings": [
                {
                    "type": "text",
                    "id": "question",
                    "label": "Question",
                    "default": "What is your return policy?"
                },
                {
                    "type": "richtext",
                    "id": "answer",
                    "label": "Answer",
                    "default": "<p>We offer a 30-day return policy.</p>"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "FAQ Accordion",
            "blocks": [
                {
                    "type": "faq_item",
                    "settings": {
                        "question": "What is your return policy?",
                        "answer": "<p>We offer a 30-day return policy.</p>"
                    }
                },
                {
                    "type": "faq_item",
                    "settings": {
                        "question": "When do I receive the package?",
                        "answer": "<p>It takes 3 to 5 business days to deliver your package.</p>"
                    }
                }
            ]
        }
    ]
}
{% endschema %}