{{ 'section-custom-collection.css' | asset_url | stylesheet_tag }}
<section class="custom-collection">
    <div class="customer-collection__header">
        {% if section.settings.heading != blank %}
            <h2 class="custom-collection__heading">{{ section.settings.heading }}</h2>
        {% endif %}
    </div>

    <div class="custom-collection__grid">
        {% if section.settings.collection != blank %}
            {%- for product in section.settings.collection.products limit: section.settings.product_to_show -%}
                <a href="{{ product.url }}" class="custom-collection__item">
                    <img
                        src="{{ product.featured_image | image_url: width: 600 }}"
                        alt="{{ product.featured_image.alt }}"
                        width="600"
                        height="600">
                    <p class="custom-collection__product-title">{{ product.title }} </p>
                    <p class="custom-collection__product-price">{{ product.price | money }} </p>
                </a>
            {%- endfor -%}
        {% else %}
            <p class="custom_collection__empty">Please select a collection.</p>
        {% endif %}
    </div>

</section>

{% schema %}
{
    "name": "Custom Collection",
    "settings": [
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Featured Collection"
        },
        {
            "type": "collection",
            "id": "collection",
            "label": "Collection"
        },
        {
            "type": "range",
            "id": "product_to_show",
            "label": "Product to show",
            "min": 2,
            "max": 12,
            "step": 2,
            "default": 4
        }
    ],
    "presets": [
        {
            "name": "Custom Collection"
        }
    ]
}
{% endschema %}